#!/bin/sh
# ECN Spray G3 - OpenFOAM v14 (multicomponentFluid + sprayCloud)
# usage:  ./Allrun [nProcs]          (default 4, must match system/decomposeParDict)
#         MESH_REFINE=1 ./Allrun 4   near-nozzle refinement 1 -> 0.5 -> 0.25 mm (~1.4 M cells, ~4-5 h)
#         ./Allrun smoke             (serial, 20 time steps, just to catch dictionary errors)
cd "$(dirname "$0")" || exit 1

NP=${1:-4}

run() {   # run <log> <command...>
    log=$1; shift
    echo "running: $*  > $log"
    "$@" > "$log" 2>&1 || { echo "FAILED - see $log"; tail -20 "$log"; exit 1; }
}

# cloudProperties: regenerated from the script defaults, unless you pass generator flags via CLOUD_ARGS
#   e.g.  CLOUD_ARGS="--drag sphereDrag --oscillation no --breakup none" sh Allrun smoke
#   or    KEEP_CLOUD=1 sh Allrun smoke      (use constant/cloudProperties as it is)
if [ "${KEEP_CLOUD:-0}" != "1" ]; then
    python3 tools/make_cloudProperties.py ${CLOUD_ARGS:-} || exit 1
fi

run log.blockMesh  blockMesh

if [ "${MESH_REFINE:-0}" = "1" ]; then
    # two nested cylinders below the nozzle (system/refineMeshDict.l1, .l2)
    OVW=""; refineMesh -help 2>/dev/null | grep -q -- "-overwrite" && OVW="-overwrite"
    for lvl in l1 l2; do
        cp system/refineMeshDict.$lvl system/refineMeshDict
        run log.refineMesh.$lvl refineMesh $OVW
    done
    rm -f system/refineMeshDict
    if [ -z "$OVW" ]; then
        echo "WARNING: refineMesh has no -overwrite option here; check that the refined mesh is in constant/polyMesh"
        ls -d [0-9]* 2>/dev/null
    fi
fi

run log.checkMesh  checkMesh
grep -E "^ *cells:" log.checkMesh

if [ "$NP" = "smoke" ]; then
    # quick dictionary check: a few steps in serial, no writing
    foamDictionary -entry endTime -set 2e-6 system/controlDict > /dev/null
    foamRun > log.smoke 2>&1
    status=$?
    foamDictionary -entry endTime -set 1.56e-3 system/controlDict > /dev/null
    if [ $status -ne 0 ]; then
        echo "SMOKE FAILED - last lines of log.smoke:"
        grep -E "^Time =|Current number of parcels|Current mass in system|Floating|FOAM FATAL|keyword" log.smoke | tail -15
        exit 1
    fi
    grep -E "Current number of parcels|Current mass in system" log.smoke | tail -4
    echo "smoke test OK"
    exit 0
fi

run log.decomposePar   decomposePar -force
echo "running: mpirun -np $NP foamRun -parallel  > log.foamRun"
mpirun -np "$NP" foamRun -parallel > log.foamRun 2>&1 || { echo "FAILED - see log.foamRun"; exit 1; }
run log.reconstructPar reconstructPar

# --- data for postprocess/g3_validate.py ---
run log.writeCellCentres foamPostProcess -func writeCellCentres -time 0     # writes 0/Cz used for vapour penetration
run log.foamToVTK        foamToVTK -ascii -useTimeName -noInternal          # parcels -> VTK/lagrangian/cloud/*.vtk

echo "done. Now:  python3 ../postprocess/g3_validate.py ."
