            flowType        flowRateAndDischarge;
            dInner          0;
            dOuter          165e-6;
            duration        0.78e-3;
            position        (0.0001 0 0);
            direction       (0.819152 0.0 0.573576);
            parcelsPerSecond 500000;
            flowRateProfile table ((0 1.603e-3) (0.78e-3 1.603e-3) (0.780001e-3 0) (1000 0));
            Cd              constant 0.73;
            thetaInner      constant 0.0;
            thetaOuter      constant 15.0;
            sizeDistribution { type fixedValue; value 165e-6; }
        }
        model3
        {
            type            coneInjection;
            SOI             0;
            massTotal       1.25e-6;
            uniformParcelSize volume;
            injectionMethod disc;
            flowType        flowRateAndDischarge;
            dInner          0;
            dOuter          165e-6;
            duration        0.78e-3;
            position        (0.0001 0 0);
            direction       (0.819152 -0.405580 0.405580);
            parcelsPerSecond 500000;
            flowRateProfile table ((0 1.603e-3) (0.78e-3 1.603e-3) (0.780001e-3 0) (1000 0));
            Cd              constant 0.73;
            thetaInner      constant 0.0;
            thetaOuter      constant 15.0;
            sizeDistribution { type fixedValue; value 165e-6; }
        }
        model4
        {
            type            coneInjection;
            SOI             0;
            massTotal       1.25e-6;
            uniformParcelSize volume;
            injectionMethod disc;
            flowType        flowRateAndDischarge;
            dInner          0;
            dOuter          165e-6;
            duration        0.78e-3;
            position        (0.0001 0 0);
            direction       (0.819152 -0.573576 0.0);
            parcelsPerSecond 500000;
            flowRateProfile table ((0 1.603e-3) (0.78e-3 1.603e-3) (0.780001e-3 0) (1000 0));
            Cd              constant 0.73;
            thetaInner      constant 0.0;
            thetaOuter      constant 15.0;
            sizeDistribution { type fixedValue; value 165e-6; }
        }
        model5
        {
            type            coneInjection;
            SOI             0;
            massTotal       1.25e-6;
            uniformParcelSize volume;
            injectionMethod disc;
            flowType        flowRateAndDischarge;
            dInner          0;
            dOuter          165e-6;
            duration        0.78e-3;
            position        (0.0001 0 0);
            direction       (0.819152 -0.405580 -0.405580);
            parcelsPerSecond 500000;
            flowRateProfile table ((0 1.603e-3) (0.78e-3 1.603e-3) (0.780001e-3 0) (1000 0));
            Cd              constant 0.73;
            thetaInner      constant 0.0;
            thetaOuter      constant 15.0;
            sizeDistribution { type fixedValue; value 165e-6; }
        }
        model6
        {
            type            coneInjection;
            SOI             0;
            massTotal       1.25e-6;
            uniformParcelSize volume;
            injectionMethod disc;
            flowType        flowRateAndDischarge;
            dInner          0;
            dOuter          165e-6;
            duration        0.78e-3;
            position        (0.0001 0 0);
            direction       (0.819152 0.0 -0.573576);
